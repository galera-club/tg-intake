# Скопировать в .env и заполнить. Настоящие значения в репозиторий не попадают.
DATABASE_URL=postgres://intake:intake@localhost:5432/intake?sslmode=disable

# Токен бота из BotFather. Локальный прогон берёт токен отдельного тестового
# бота: один токен - один поллер, иначе локальный запуск забирает апдейты
# контура, а Telegram отвечает 409 тому, кто опрашивает вторым.
TELEGRAM_BOT_TOKEN=000000000:REPLACE_ME

# Белый список Telegram ID через запятую. Чужому бот отвечает отказом.
TELEGRAM_ALLOWED_IDS=100000001,100000002

# Прокси для Bot API. Пусто - напрямую; на хостах с закрытым егрессом сюда
# идёт адрес SOCKS-туннеля вида socks5://host:port.
TELEGRAM_PROXY=

# Чат уведомлений владельца: туда уходит шапка нового и отменённого тикета.
# Пусто - уведомлений нет. У группы и канала chat_id отрицательный.
ALERT_CHAT_ID=

# Токен бота, которым пишем в этот чат. Пусто - пишет бот сервиса, и тогда он
# должен быть участником чата. Заполняется, когда лента уведомлений уже ведётся
# другим ботом: берём его токен, чтобы сообщения шли одной лентой.
ALERT_BOT_TOKEN=

# Тема группы уведомлений (message_thread_id Bot API). Пусто - без темы,
# сообщение уходит в общий чат, как раньше. Тема без заданного ALERT_CHAT_ID
# не ошибка: уведомления в этом случае выключены целиком.
ALERT_THREAD_ID=

# База для TestMigrations: тест дропает всю схему, поэтому переменная отдельная
# и заполняется только локальной базой. Пустая - тест пропускается.
TEST_DATABASE_URL=postgres://intake:intake@localhost:5432/intake?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info
ENV=local

# Ключ OpenRouter.
OPENROUTER_API_KEY=REPLACE_ME

# HTTP-прокси только для OpenRouter. Пусто - идём напрямую; заполняется там, где
# хосту закрыт прямой путь и API отвечает 403 от фильтра по дороге. Telegram и
# GitHub этот прокси не используют.
OPENROUTER_PROXY=

# Модель для голоса и скриншотов.
OPENROUTER_MODEL_MEDIA=google/gemini-3.1-flash-lite

# Модель для интервью и саммари.
OPENROUTER_MODEL_DIALOG=deepseek/deepseek-v4-flash-0731

# Бюджет размышлений диалоговой модели: off, none, minimal, low, medium, high.
# Размышления считаются выходными токенами и занимают больше времени, чем сам
# ответ: без предела шаг интервью уходил на две минуты. off - не передавать
# параметр вовсе, для моделей без reasoning.
OPENROUTER_REASONING_DIALOG=low

# Fine-grained PAT на репозиториях проектов, права два: Issues: read and write
# для тикетов и Contents: read для режима «Спросить» - он читает md-файлы
# репозитория. Оба проверяются на старте по каждому проекту.
GITHUB_TOKEN=REPLACE_ME

# Стартовый набор проектов: JSON-массив, читается при старте и вставляет
# недостающие строки в projects. Существующие не трогает - править проект нужно
# командой /project в боте, иначе рестарт откатывал бы правки. Пусто - таблицу
# не трогаем вовсе. Реальные внутренние проекты задаются в конфиге контура и в
# репозиторий не коммитятся: он публичный.
#
# Поля: slug (^[a-z0-9-]{1,32}$), title, owner, repo, context - все обязательны;
# active по умолчанию true, false убирает проект из меню, сохраняя его тикеты.
PROJECTS=[{"slug":"tg-intake","title":"Предложка (сам бот)","owner":"galera-club","repo":"tg-intake","context":"Telegram-бот приёма обращений: доводит сырой фидбек интервью до готового описания и заводит тикет."}]

# Каталог временных файлов обращения, создаётся и проверяется на запись при старте.
MEDIA_DIR=/tmp/intake

# Предел элементов в одном обращении.
MAX_ITEMS=30

# Сколько раундов вопросов бот задаёт, прежде чем собрать саммари с пробелами.
INTERVIEW_ROUNDS=2
